# Windows 本地直连 PostgreSQL 的配置模板。
# 复制为 .env.local 后填写真实值；该文件已被 .gitignore 忽略，切勿提交。
DB_HOST=<PostgreSQL地址或主机名>
DB_PORT=5432
DB_NAME=lease_platform
DB_USER=<PostgreSQL用户名>
DB_PASSWORD=<PostgreSQL密码>

# 仅受信任内网可使用 disable；数据库启用 TLS 时使用 require。
# 需要证书校验时，请改用带 sslmode=verify-full 等参数的 DATABASE_URL。
DB_SSLMODE=disable
APP_ADDR=127.0.0.1:8080
APP_API_KEY=
BUSINESS_TIME_ZONE=Asia/Shanghai
AUTO_MIGRATE=true
