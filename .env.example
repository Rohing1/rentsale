# Copy this file to .env and replace every placeholder before starting Docker Compose.
POSTGRES_DB=<your_database_name>
POSTGRES_USER=<your_database_user>
POSTGRES_PASSWORD=<choose_a_strong_local_password>
APP_PORT=8080
BUSINESS_TIME_ZONE=Asia/Shanghai
AUTO_MIGRATE=true
DB_SSLMODE=disable

# Required by Docker Compose. Set a unique local value; never commit the populated .env file.
APP_API_KEY=
